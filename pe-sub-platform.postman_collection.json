    {
      "name": "pe-sub-extraction",
      "description": "Document extraction service — port 3002",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{extractionBase}}/health",
              "host": ["{{extractionBase}}"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "Extract LP records from file",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "facilityId", "value": "{{facilityId}}", "type": "text", "description": "Target facility ID (forwarded to pe-sub-api)" },
                { "key": "file",       "src": "",                 "type": "file", "description": "XLSX, XLS, or CSV agent schedule (max 50 MB)" }
              ]
            },
            "url": {
              "raw": "{{extractionBase}}/api/extract",
              "host": ["{{extractionBase}}"],
              "path": ["api", "extract"]
            },
            "description": "Parses the uploaded agent schedule, detects the bank template (Citibank, JPM, Goldman Sachs, Barclays, UBS), extracts LP records with per-field confidence scores, and forwards the result to pe-sub-api/lps/ingest. Returns the ExtractionResult regardless of forwarding outcome."
          },
          "response": []
        }
      ]
    },
