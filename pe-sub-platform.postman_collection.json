{
  "info": {
    "_postman_id": "7a3b9f21-4d8c-4e6a-b1d5-2c9e8f0a7b3d",
    "name": "PE Sub Platform",
    "description": "REST API collection for the PE Subscription Borrowing Base Platform.\n\nServices\n────────\n  pe-sub-api         http://localhost:3001   Core API\n  pe-sub-extraction  http://localhost:3002   Document extraction\n\nSync source: pe-sub-docs/openapi.yaml v0.5.0\n\nBefore running: update the collection variables (facilityId, lpId, etc.) to match your local seed data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base",             "value": "http://localhost:3001", "type": "string", "description": "pe-sub-api host" },
    { "key": "extractionBase",   "value": "http://localhost:3002", "type": "string", "description": "pe-sub-extraction host" },
    { "key": "facilityId",       "value": "1",                     "type": "string" },
    { "key": "lpId",             "value": "1",                     "type": "string" },
    { "key": "submissionId",     "value": "1",                     "type": "string" },
    { "key": "aliasId",          "value": "1",                     "type": "string" },
    { "key": "matchQueueItemId", "value": "1",                     "type": "string" }
  ],
  "item": [
    {
      "name": "pe-sub-api",
      "description": "Core REST API — port 3001",
      "item": [
        {
          "name": "Health",
          "item": [
            {
              "name": "Health check",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/health",
                  "host": ["{{base}}"],
                  "path": ["health"]
                },
                "description": "Returns {\"status\":\"UP\"} when the service is healthy."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Facilities",
          "item": [
            {
              "name": "List all facilities",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/facilities",
                  "host": ["{{base}}"],
                  "path": ["api", "facilities"]
                },
                "description": "Returns all facilities sorted by name."
              },
              "response": []
            },
            {
              "name": "Get facility by ID",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/facilities/{{facilityId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "facilities", "{{facilityId}}"]
                }
              },
              "response": []
            },
            {
              "name": "Create facility",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"BCRED Fund IV\",\n  \"agentBank\": \"Citibank\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/facilities",
                  "host": ["{{base}}"],
                  "path": ["api", "facilities"]
                }
              },
              "response": []
            },
            {
              "name": "Update facility status",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"In Progress\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/facilities/{{facilityId}}/status",
                  "host": ["{{base}}"],
                  "path": ["api", "facilities", "{{facilityId}}", "status"]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "LPs",
          "item": [
            {
              "name": "List all LPs",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/lps",
                  "host": ["{{base}}"],
                  "path": ["api", "lps"]
                },
                "description": "Returns all LPs across all facilities, ordered by rank."
              },
              "response": []
            },
            {
              "name": "List LPs by facility",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/lps?facilityId={{facilityId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "lps"],
                  "query": [
                    { "key": "facilityId", "value": "{{facilityId}}", "description": "Filter by facility" }
                  ]
                }
              },
              "response": []
            },
            {
              "name": "List LPs by facility + classification",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/lps?facilityId={{facilityId}}&cls=Rated",
                  "host": ["{{base}}"],
                  "path": ["api", "lps"],
                  "query": [
                    { "key": "facilityId", "value": "{{facilityId}}" },
                    { "key": "cls",        "value": "Rated", "description": "Rated | Approved | Institutional | Other | Ineligible" }
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Search LPs",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/lps?facilityId={{facilityId}}&search=blackstone",
                  "host": ["{{base}}"],
                  "path": ["api", "lps"],
                  "query": [
                    { "key": "facilityId", "value": "{{facilityId}}" },
                    { "key": "search",     "value": "blackstone", "description": "Case-insensitive name substring search" }
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Get LP by ID",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/lps/{{lpId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "lps", "{{lpId}}"]
                }
              },
              "response": []
            },
            {
              "name": "Update LP fields",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"cls\": \"Rated\",\n  \"clsTag\": \"S&P BB\",\n  \"abb\": \"N\",\n  \"inc\": true,\n  \"rcl\": false,\n  \"notes\": \"Reviewed by credit committee Q2 2026\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/lps/{{lpId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "lps", "{{lpId}}"]
                },
                "description": "Updatable fields: cls, clsTag, abb, inc, rcl, notes. Omit any field to leave it unchanged."
              },
              "response": []
            },
            {
              "name": "Ingest extracted LP records",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"facilityId\": {{facilityId}},\n  \"extraction\": {\n    \"template\": {\n      \"format\": \"CITIBANK\",\n      \"version\": null,\n      \"headerRowIndex\": 2\n    },\n    \"records\": [\n      {\n        \"rowIndex\": 3,\n        \"investorName\":       { \"value\": \"Blackstone Capital Partners\", \"confidence\": 1.0,  \"sourceHeader\": \"Investor Name\" },\n        \"commitment\":         { \"value\": 50000000,                       \"confidence\": 0.85, \"sourceHeader\": \"Total Commitment\" },\n        \"uncalled\":           { \"value\": 30000000,                       \"confidence\": 0.85, \"sourceHeader\": \"Unfunded Commitment\" },\n        \"aum\":                { \"value\": 120000000000,                   \"confidence\": 1.0,  \"sourceHeader\": \"AUM\" },\n        \"agentRate\":          { \"value\": 0.65,                           \"confidence\": 1.0,  \"sourceHeader\": \"Advance Rate\" },\n        \"concentrationLimit\": { \"value\": 0.10,                           \"confidence\": 0.85, \"sourceHeader\": \"Conc. Limit\" },\n        \"requiresReview\": false,\n        \"warnings\": []\n      },\n      {\n        \"rowIndex\": 4,\n        \"investorName\":       { \"value\": \"KKR Credit Opportunities\",     \"confidence\": 0.65, \"sourceHeader\": \"Investor Name\" },\n        \"commitment\":         { \"value\": 25000000,                       \"confidence\": 0.85, \"sourceHeader\": \"Total Commitment\" },\n        \"uncalled\":           { \"value\": 15000000,                       \"confidence\": 0.85, \"sourceHeader\": \"Unfunded Commitment\" },\n        \"aum\":                { \"value\": null,                           \"confidence\": 0.0,  \"sourceHeader\": null },\n        \"agentRate\":          { \"value\": 0.50,                           \"confidence\": 1.0,  \"sourceHeader\": \"Advance Rate\" },\n        \"concentrationLimit\": { \"value\": 0.10,                           \"confidence\": 0.85, \"sourceHeader\": \"Conc. Limit\" },\n        \"requiresReview\": true,\n        \"warnings\": [\n          { \"field\": \"investorName\", \"message\": \"low confidence 65% — header: Investor Name\", \"rowIndex\": 4 },\n          { \"field\": \"aum\",         \"message\": \"column not found in spreadsheet\",             \"rowIndex\": 4 }\n        ]\n      }\n    ],\n    \"totalFlagged\": 1\n  }\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/lps/ingest",
                  "host": ["{{base}}"],
                  "path": ["api", "lps", "ingest"]
                },
                "description": "Called by pe-sub-extraction after parsing an agent schedule. Each row is matched against the facility's LP records. Actions: Updated (fields written), Queued (credit officer review needed), Skipped (no match)."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Borrowing Base",
