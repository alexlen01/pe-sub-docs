{
  "info": {
    "_postman_id": "7a3b9f21-4d8c-4e6a-b1d5-2c9e8f0a7b3d",
    "name": "PE Sub Platform",
    "description": "REST API collection for the PE Subscription Borrowing Base Platform.\n\nServices\n────────\n  pe-sub-api         http://localhost:3001   Core API\n  pe-sub-extraction  http://localhost:3002   Document extraction\n\nSync source: pe-sub-docs/openapi.yaml v0.7.0\n\nBefore running: update the collection variables (facilityId, lpId, etc.) to match your local seed data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base",             "value": "http://localhost:3001", "type": "string", "description": "pe-sub-api host" },
    { "key": "extractionBase",   "value": "http://localhost:3002", "type": "string", "description": "pe-sub-extraction host" },
    { "key": "facilityId",       "value": "1",                     "type": "string" },
    { "key": "lpId",             "value": "1",                     "type": "string" },
    { "key": "submissionId",     "value": "1",                     "type": "string" },
    { "key": "aliasId",          "value": "1",                     "type": "string" },
    { "key": "matchQueueItemId", "value": "1",                     "type": "string" }
  ],
  "item": [
    {
      "name": "pe-sub-api",
      "description": "Core REST API — port 3001",
      "item": [
        {
          "name": "Health",
          "item": [
            {
              "name": "Health check",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/health",
                  "host": ["{{base}}"],
                  "path": ["health"]
                },
                "description": "Returns {\"status\":\"UP\"} when the service is healthy."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Facilities",
          "item": [
            {
              "name": "List all facilities",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/facilities",
                  "host": ["{{base}}"],
                  "path": ["api", "facilities"]
                },
                "description": "Returns all facilities sorted by name."
              },
              "response": []
            },
            {
              "name": "Get facility by ID",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/facilities/{{facilityId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "facilities", "{{facilityId}}"]
                }
              },
              "response": []
            },
            {
              "name": "Create facility",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"BCRED Fund IV\",\n  \"agentBank\": \"Citibank\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/facilities",
                  "host": ["{{base}}"],
                  "path": ["api", "facilities"]
                }
              },
              "response": []
            },
            {
              "name": "Update facility status",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"In Progress\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/facilities/{{facilityId}}/status",
                  "host": ["{{base}}"],
                  "path": ["api", "facilities", "{{facilityId}}", "status"]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "LPs",
          "item": [
            {
              "name": "List all LPs",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/lps",
                  "host": ["{{base}}"],
                  "path": ["api", "lps"]
                },
                "description": "Returns all LPs across all facilities, ordered by rank."
              },
              "response": []
            },
            {
              "name": "List LPs by facility",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/lps?facilityId={{facilityId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "lps"],
                  "query": [
                    { "key": "facilityId", "value": "{{facilityId}}", "description": "Filter by facility" }
                  ]
                }
              },
              "response": []
            },
            {
              "name": "List LPs by facility + classification",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/lps?facilityId={{facilityId}}&cls=Rated",
                  "host": ["{{base}}"],
                  "path": ["api", "lps"],
                  "query": [
                    { "key": "facilityId", "value": "{{facilityId}}" },
                    { "key": "cls",        "value": "Rated", "description": "Rated | Unrated >2bn | Unrated 1-2bn | Eligible | Excluded" }
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Search LPs",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/lps?facilityId={{facilityId}}&search=blackstone",
                  "host": ["{{base}}"],
                  "path": ["api", "lps"],
                  "query": [
                    { "key": "facilityId", "value": "{{facilityId}}" },
                    { "key": "search",     "value": "blackstone", "description": "Case-insensitive name substring search" }
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Get LP by ID",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/lps/{{lpId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "lps", "{{lpId}}"]
                }
              },
              "response": []
            },
            {
              "name": "Update LP fields",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"cls\": \"Rated\",\n  \"clsTag\": \"tag-rated\",\n  \"abb\": \"$22.5M\",\n  \"inc\": true,\n  \"rcl\": false,\n  \"notes\": \"Reviewed by credit committee Q2 2026\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/lps/{{lpId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "lps", "{{lpId}}"]
                },
                "description": "Updatable fields: cls, clsTag, abb, inc, rcl, notes. Omit any field to leave it unchanged."
              },
              "response": []
            },
            {
              "name": "Ingest extracted LP records",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"facilityId\": {{facilityId}},\n  \"extraction\": {\n    \"template\": {\n      \"format\": \"CITIBANK\",\n      \"version\": null,\n      \"headerRowIndex\": 2\n    },\n    \"records\": [\n      {\n        \"rowIndex\": 3,\n        \"investorName\":       { \"value\": \"Blackstone Capital Partners\", \"confidence\": 1.0,  \"sourceHeader\": \"Investor Name\" },\n        \"commitment\":         { \"value\": 50000000,                       \"confidence\": 0.85, \"sourceHeader\": \"Total Commitment\" },\n        \"uncalled\":           { \"value\": 30000000,                       \"confidence\": 0.85, \"sourceHeader\": \"Unfunded Commitment\" },\n        \"aum\":                { \"value\": 120000000000,                   \"confidence\": 1.0,  \"sourceHeader\": \"AUM\" },\n        \"agentRate\":          { \"value\": 0.65,                           \"confidence\": 1.0,  \"sourceHeader\": \"Advance Rate\" },\n        \"concentrationLimit\": { \"value\": 0.10,                           \"confidence\": 0.85, \"sourceHeader\": \"Conc. Limit\" },\n        \"requiresReview\": false,\n        \"warnings\": []\n      }\n    ],\n    \"totalFlagged\": 0\n  }\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/lps/ingest",
                  "host": ["{{base}}"],
                  "path": ["api", "lps", "ingest"]
                },
                "description": "Called internally by pe-sub-api after extraction. Each row is matched against the facility's LP records. Actions: Updated (fields written), Queued (credit officer review needed), Skipped (no match)."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Borrowing Base",
          "item": [
            {
              "name": "Run shadow BB",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/bb/run/{{facilityId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "bb", "run", "{{facilityId}}"]
                },
                "description": "Computes and persists a new shadow BB snapshot for the facility. Returns the snapshot with per-LP computed values."
              },
              "response": []
            },
            {
              "name": "List BB snapshots",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/bb/snapshots/{{facilityId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "bb", "snapshots", "{{facilityId}}"]
                },
                "description": "All BB snapshots for the facility, in ascending order."
              },
              "response": []
            },
            {
              "name": "Get latest BB snapshot",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/bb/snapshots/{{facilityId}}/latest",
                  "host": ["{{base}}"],
                  "path": ["api", "bb", "snapshots", "{{facilityId}}", "latest"]
                }
              },
              "response": []
            },
            {
              "name": "Get extended BB summary",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/bb/summary-ext/{{facilityId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "bb", "summary-ext", "{{facilityId}}"]
                },
                "description": "Extended analytics: LP portfolio stats, BB comparison, BUSA/agent rate breakdown, classification breakdown. Returns zero-valued object when no LPs exist."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Reports",
          "item": [
            {
              "name": "Collateral report",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/reports/collateral/{{facilityId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "reports", "collateral", "{{facilityId}}"]
                },
                "description": "Collateral summary derived from the latest BB snapshot."
              },
              "response": []
            },
            {
              "name": "Concentration report",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/reports/concentration/{{facilityId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "reports", "concentration", "{{facilityId}}"]
                },
                "description": "Concentration breaches derived from the latest BB snapshot."
              },
              "response": []
            },
            {
              "name": "[PLANNED] EAR report",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/reports/ear/{{facilityId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "reports", "ear", "{{facilityId}}"]
                },
                "description": "[PLANNED — returns 404] Effective Advance Rate history — array of { calculatedAt, ear, agentEar, earDelta } data points across all BB snapshots."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Submissions",
          "item": [
            {
              "name": "List all submissions",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/submissions",
                  "host": ["{{base}}"],
                  "path": ["api", "submissions"]
                },
                "description": "Returns all submissions ordered newest first. Submissions with status=Processing are filtered out."
              },
              "response": []
            },
            {
              "name": "List submissions by facility",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/submissions?facilityId={{facilityId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "submissions"],
                  "query": [
                    { "key": "facilityId", "value": "{{facilityId}}" }
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Upload agent schedule",
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    { "key": "facilityId",   "value": "{{facilityId}}", "type": "text" },
                    { "key": "agentBank",    "value": "Citibank",       "type": "text", "description": "Citibank | JPMorgan | Goldman Sachs | Barclays | Bank of America | Wells Fargo | UBS" },
                    { "key": "periodMonth",  "value": "2026-05-31",     "type": "text", "description": "YYYY-MM-DD" },
                    { "key": "file",         "src": "",                 "type": "file", "description": "XLSX, XLS, or CSV (max 50 MB)" },
                    { "key": "notes",        "value": "",               "type": "text", "description": "Optional analyst notes", "disabled": true }
                  ]
                },
                "url": {
                  "raw": "{{base}}/api/submissions",
                  "host": ["{{base}}"],
                  "path": ["api", "submissions"]
                },
                "description": "Multipart upload. Triggers pe-sub-extraction immediately. Returns 201 with submission metadata (wizardStep=1, status=Processing). Status advances to Review once extraction completes."
              },
              "response": []
            },
            {
              "name": "Get submission by ID",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/submissions/{{submissionId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "submissions", "{{submissionId}}"]
                }
              },
              "response": []
            },
            {
              "name": "Abort submission",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/submissions/{{submissionId}}/abort",
                  "host": ["{{base}}"],
                  "path": ["api", "submissions", "{{submissionId}}", "abort"]
                },
                "description": "Deletes the uploaded file, submission_extractions row, and match queue entries. Resets facility status if no other active submissions. Returns 204 No Content on success. Returns 409 if already Processed or already Aborted."
              },
              "response": []
            },
            {
              "name": "Confirm extraction",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/submissions/{{submissionId}}/confirm",
                  "host": ["{{base}}"],
                  "path": ["api", "submissions", "{{submissionId}}", "confirm"]
                },
                "description": "Advances submission to wizardStep=4. Auto-learns BB template (sheet name + header row) for the agent bank on first confirmation. (Re)builds match_queue_entries from the extracted LP rows. Returns { templateSaved: boolean, agentBank: string }."
              },
              "response": []
            },
            {
              "name": "Save Shadow BB state",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"overrides\": {\n    \"42\": { \"cls\": \"Rated\", \"agentRate\": \"90%\" }\n  }\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/submissions/{{submissionId}}/shadow-bb-state",
                  "host": ["{{base}}"],
                  "path": ["api", "submissions", "{{submissionId}}", "shadow-bb-state"]
                },
                "description": "Advances submission to wizardStep=5. Optionally persists per-LP classification/rate overrides (keyed by LP id) in shadow_bb_overrides. Called on 'Commit Decisions' (no overrides) and on 'Save' (with overrides) on the Run Shadow BB screen. Returns updated Submission."
              },
              "response": []
            },
            {
              "name": "Get extracted LPs",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/submissions/{{submissionId}}/extracted-lps",
                  "host": ["{{base}}"],
                  "path": ["api", "submissions", "{{submissionId}}", "extracted-lps"]
                },
                "description": "Returns the extracted_lps JSONB from submission_extractions — array of formatted LP rows with per-row confidence scores and computed agentBBFmt/pctBBFmt fields."
              },
              "response": []
            },
            {
              "name": "Get field map",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/submissions/{{submissionId}}/field-map",
                  "host": ["{{base}}"],
                  "path": ["api", "submissions", "{{submissionId}}", "field-map"]
                },
                "description": "Returns an array of { extracted, canonical, group, note, tier } entries — one per recognised column. Used to render the column mapping review table."
              },
              "response": []
            },
            {
              "name": "Get doc recognition",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/submissions/{{submissionId}}/doc-recognition",
                  "host": ["{{base}}"],
                  "path": ["api", "submissions", "{{submissionId}}", "doc-recognition"]
                },
                "description": "Returns: { document, format, tablesIdentified, tableLocation, headerRow, totalRows, mappedColumns, unmatchedColumns, headerInfo }."
              },
              "response": []
            },
            {
              "name": "Get unrecognized columns",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/submissions/{{submissionId}}/unrecognized-columns",
                  "host": ["{{base}}"],
                  "path": ["api", "submissions", "{{submissionId}}", "unrecognized-columns"]
                },
                "description": "Returns column headers from the uploaded document that could not be matched to any canonical LP field."
              },
              "response": []
            },
            {
              "name": "Remap column",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"extractedHeader\": \"Unfunded Commitment\",\n  \"canonical\": \"UNCALLED\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/submissions/{{submissionId}}/remap",
                  "host": ["{{base}}"],
                  "path": ["api", "submissions", "{{submissionId}}", "remap"]
                },
                "description": "Saves a User-tier alias (extractedHeader → canonical) then immediately re-extracts. Returns 200 OK on success. Returns 502 if alias saved but pe-sub-extraction is unreachable — retry with POST /reextract."
              },
              "response": []
            },
            {
              "name": "Re-extract",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/submissions/{{submissionId}}/reextract",
                  "host": ["{{base}}"],
                  "path": ["api", "submissions", "{{submissionId}}", "reextract"]
                },
                "description": "Re-runs the full extraction pipeline using the stored file plus any saved column remappings and BB template hints for the agent bank. Returns 204 No Content on success. Returns 502 if pe-sub-extraction is unreachable."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Field Mapping",
          "item": [
            {
              "name": "Get alias groups",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/field-mapping/alias-groups",
                  "host": ["{{base}}"],
                  "path": ["api", "field-mapping", "alias-groups"]
                },
                "description": "Canonical fields with their aliases, grouped by LP Master section."
              },
              "response": []
            },
            {
              "name": "Get canonical fields",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/field-mapping/canonical-fields",
                  "host": ["{{base}}"],
                  "path": ["api", "field-mapping", "canonical-fields"]
                },
                "description": "Flat list of canonical fields (value, label, extractable). Used to populate mapping dropdowns."
              },
              "response": []
            },
            {
              "name": "Get blocklist",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/field-mapping/blocklist",
                  "host": ["{{base}}"],
                  "path": ["api", "field-mapping", "blocklist"]
                },
                "description": "Qualifier blocklist — terms that disqualify a column header from matching."
              },
              "response": []
            },
            {
              "name": "Get mapping suggestions",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/field-mapping/suggestions",
                  "host": ["{{base}}"],
                  "path": ["api", "field-mapping", "suggestions"]
                }
              },
              "response": []
            },
            {
              "name": "Submit mapping suggestion",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"extractedHeader\": \"Fund Manager\",\n  \"canonicalField\": \"investor_name\",\n  \"suggestedBy\": \"J. Smith\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/field-mapping/suggestions",
                  "host": ["{{base}}"],
                  "path": ["api", "field-mapping", "suggestions"]
                }
              },
              "response": []
            },
            {
              "name": "Add alias",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"canonicalFieldId\": 1,\n  \"text\": \"Fund Manager\",\n  \"tier\": \"Bank\",\n  \"bank\": \"Citibank\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/field-mapping/aliases",
                  "host": ["{{base}}"],
                  "path": ["api", "field-mapping", "aliases"]
                },
                "description": "tier: Core | Bank | User. Returns 409 Conflict if the alias text is already mapped to another canonical field."
              },
              "response": []
            },
            {
              "name": "Update alias",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"text\": \"Fund Manager Name\",\n  \"bank\": \"Citibank\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/field-mapping/aliases/{{aliasId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "field-mapping", "aliases", "{{aliasId}}"]
                },
                "description": "Returns 409 Conflict if the new text is already mapped to another canonical field."
              },
              "response": []
            },
            {
              "name": "Delete alias",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/field-mapping/aliases/{{aliasId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "field-mapping", "aliases", "{{aliasId}}"]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Matching",
          "item": [
            {
              "name": "Test LP name match",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Blackstone Capital Partners\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/matching/test",
                  "host": ["{{base}}"],
                  "path": ["api", "matching", "test"]
                },
                "description": "Runs fuzzy LP name matching (Jaro-Winkler + Levenshtein) against all LP names. Returns { input, normalised, matches: [{ name, score, action }] } where action is Accept | Queue | Reject."
              },
              "response": []
            },
            {
              "name": "List match queue",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/matching/queue?submissionId={{submissionId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "matching", "queue"],
                  "query": [
                    { "key": "submissionId", "value": "{{submissionId}}", "description": "Optional: filter by submission. Omit to return all queue entries." }
                  ]
                },
                "description": "Returns match_queue_entries for the given submission — one row per extracted LP queued for credit officer review."
              },
              "response": []
            },
            {
              "name": "Resolve queue item",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"decision\": \"accepted\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/matching/queue/{{matchQueueItemId}}",
                  "host": ["{{base}}"],
                  "path": ["api", "matching", "queue", "{{matchQueueItemId}}"]
                },
                "description": "decision: accepted | rejected | manual (case-insensitive; stored capitalised). When masterName is provided and non-blank, the override is set and decision is forced to Accepted."
              },
              "response": []
            },
            {
              "name": "[PLANNED] Get matching thresholds",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/matching/thresholds",
                  "host": ["{{base}}"],
                  "path": ["api", "matching", "thresholds"]
                },
                "description": "[PLANNED] Use GET /api/config/matching instead — thresholds are stored under matching_config."
              },
              "response": []
            },
            {
              "name": "[PLANNED] Update matching thresholds",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"autoAccept\": 90,\n  \"reviewQueue\": 70\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/matching/thresholds",
                  "host": ["{{base}}"],
                  "path": ["api", "matching", "thresholds"]
                },
                "description": "[PLANNED] Use PUT /api/config/matching instead."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Configuration",
          "item": [
            {
              "name": "Get eligibility config",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/config/eligibility",
                  "host": ["{{base}}"],
                  "path": ["api", "config", "eligibility"]
                },
                "description": "Returns all 6 eligibility config keys assembled from the DB cache. Response keys are SCREAMING_SNAKE_CASE: BUSA_TIERS, AGENT_TIERS, AGENT_RATE_PARAMS, ELIG_RULES, CONC_LIMITS, GLOBAL_SETTINGS. Returns 404 if no keys seeded."
              },
              "response": []
            },
            {
              "name": "Update eligibility config section",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "[\n  { \"cls\": \"Rated\",          \"rate\": 90 },\n  { \"cls\": \"Unrated >2bn\",   \"rate\": 85 },\n  { \"cls\": \"Unrated 1-2bn\", \"rate\": 80 },\n  { \"cls\": \"Eligible\",      \"rate\": 75 }\n]",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/config/eligibility?section=busa_tiers",
                  "host": ["{{base}}"],
                  "path": ["api", "config", "eligibility"],
                  "query": [
                    { "key": "section", "value": "busa_tiers", "description": "Required. Config key: busa_tiers | agent_tiers | agent_rate_params | elig_rules | conc_limits | global_settings" }
                  ]
                },
                "description": "Upserts a single config key. The ?section= param appears in the audit log detail. Body is the new JSON value for the key."
              },
              "response": []
            },
            {
              "name": "Get matching config",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/config/matching",
                  "host": ["{{base}}"],
                  "path": ["api", "config", "matching"]
                },
                "description": "Returns matching_config from DB cache: defaultThresholds (autoAccept, reviewQueue), legalSuffixes, knownAbbreviations, abbrevRegexMap. Returns 404 if not seeded."
              },
              "response": []
            },
            {
              "name": "Update matching config",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"defaultThresholds\": {\n    \"autoAccept\": 90,\n    \"reviewQueue\": 70\n  }\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/config/matching?section=thresholds",
                  "host": ["{{base}}"],
                  "path": ["api", "config", "matching"],
                  "query": [
                    { "key": "section", "value": "thresholds", "description": "Optional label for audit log: thresholds | weights | suffixes | abbreviations" }
                  ]
                },
                "description": "Replaces the full matching_config value. The ?section= param is used only in the audit log detail. Writes a 'Match Config Change' audit event."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Audit",
          "item": [
            {
              "name": "List audit log",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/audit",
                  "host": ["{{base}}"],
                  "path": ["api", "audit"]
                },
                "description": "Returns all audit rows ordered newest first. Each row: { ts, event, detail, facility, user, ip }."
              },
              "response": []
            },
            {
              "name": "Record login event",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{base}}/api/audit/login",
                  "host": ["{{base}}"],
                  "path": ["api", "audit", "login"]
                },
                "description": "No request body needed. Writes a Login audit event with the client IP. User is hardcoded to 'J. Smith' pending auth integration."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Notifications",
          "item": [
            {
              "name": "SSE event stream",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "text/event-stream" }],
                "url": {
                  "raw": "{{base}}/api/notifications/events",
                  "host": ["{{base}}"],
                  "path": ["api", "notifications", "events"]
                },
                "description": "Server-Sent Events stream. Broadcasts facility status changes, BB runs, LP reclassifications, and upload events in real time. Keep the connection open; events arrive as 'data: ...' lines. Note: Postman supports SSE via the 'Send' button."
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "pe-sub-extraction",
      "description": "Document extraction service — port 3002. Called internally by pe-sub-api on every upload and re-extraction. Use this section for direct testing only.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{extractionBase}}/health",
              "host": ["{{extractionBase}}"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "Extract LP records from file",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "facilityId",    "value": "{{facilityId}}", "type": "text",  "description": "Target facility ID (used when forwarding to pe-sub-api)" },
                { "key": "file",          "src": "",                 "type": "file",  "description": "XLSX, XLS, or CSV agent schedule (max 50 MB)" },
                { "key": "forward",       "value": "false",          "type": "text",  "description": "Set true to forward result to pe-sub-api/lps/ingest", "disabled": true },
                { "key": "aliasConfig",   "value": "",               "type": "text",  "description": "JSON alias map from FM Dictionary — overrides built-in aliases when provided", "disabled": true },
                { "key": "sheetNameHint", "value": "",               "type": "text",  "description": "Preferred sheet name; bypasses sheet heuristic when provided", "disabled": true },
                { "key": "headerRowHint", "value": "",               "type": "text",  "description": "Known header row index; bypasses header detection when provided", "disabled": true }
              ]
            },
            "url": {
              "raw": "{{extractionBase}}/api/extract",
              "host": ["{{extractionBase}}"],
              "path": ["api", "extract"]
            },
            "description": "Parses the uploaded agent schedule, detects bank template and header row, extracts LP records with per-field confidence scores. forward=false by default in this test request — pe-sub-api is not notified."
          },
          "response": []
        }
      ]
    },
