        {
          "name": "Matching",
          "item": [
            {
              "name": "Test LP name match",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Blackstone Capital Partners\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{base}}/api/matching/test",
                  "host": ["{{base}}"],
                  "path": ["api", "matching", "test"]
                },
                "description": "Runs fuzzy LP name matching (Jaro-Winkler + Levenshtein) against all LPs. Returns ranked matches with scores and Accept/Queue/Reject decisions."
              },
              "response": []
            }
          ]
        },
